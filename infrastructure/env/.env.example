# DeepSafe Environment Configuration
# Copy to .env and fill in values for your deployment.

# --- Required ---
DEEPSAFE_ENV=development
DEEPSAFE_CONFIG_FILE_PATH=./deepsafe_config.json

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/deepsafe

# Supabase Auth
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=your_jwt_secret_here

# --- Optional ---
# Celery / Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ML Ensemble Artifacts
META_MODEL_ARTIFACTS_DIR=./models/ensemble/artifacts

# Gateway
PORT=8000
WORKERS=1

# Inference
DEEPSAFE_MODELS=all
DEEPSAFE_DEVICE=auto
DEEPSAFE_PORT=8001
DEEPSAFE_MAX_WORKERS=3

# Sentry (optional)
SENTRY_DSN=

# HuggingFace (for model downloads)
HUGGINGFACE_TOKEN=
