# DeepSafe configuration. Copy to .env and edit.
#
#   cp .env.example .env
#
# Nothing here is required to run detection locally. Every value has a working
# default; the entries below exist for self-hosters who want auth, a database,
# or a queue. Never commit your .env.

# ── Inference server ───────────────────────────────────────────────────────
# Which models to load: "all", or a comma-separated subset such as "npr,aide".
# A subset is the right choice on a GPU with under 24 GB of VRAM.
DEEPSAFE_MODELS=all
# auto picks CUDA, then MPS, then CPU.
DEEPSAFE_DEVICE=auto
DEEPSAFE_PORT=8001
# Models run in parallel inside one process.
DEEPSAFE_MAX_WORKERS=4

# ── Gateway ────────────────────────────────────────────────────────────────
PORT=8000
WORKERS=1
DEEPSAFE_ENV=development
DEEPSAFE_CONFIG_FILE_PATH=./deepsafe_config.json
META_MODEL_ARTIFACTS_DIR=./models/ensemble/artifacts
# Where the gateway reaches the inference server.
INFERENCE_URL=http://localhost:8001

# ── Optional: authentication ───────────────────────────────────────────────
# Auth is REQUIRED when DEEPSAFE_ENV=production and optional otherwise, so a
# local install works with no credentials. Turn it on before exposing the
# gateway to a network.
# DEEPSAFE_REQUIRE_AUTH=true
# NEXT_PUBLIC_AUTH_ENABLED=true
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_JWT_SECRET=your_jwt_secret
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# ── Optional: database ─────────────────────────────────────────────────────
# Without this the gateway writes to ./deepsafe_local.db (SQLite), which is
# fine for one user. Required when DEEPSAFE_ENV=production.
# DATABASE_URL=postgresql://user:password@localhost:5432/deepsafe

# ── Optional: queue and rate limiting ──────────────────────────────────────
# Needed only for asynchronous detection jobs.
# REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ── Optional: error reporting ──────────────────────────────────────────────
# SENTRY_DSN=

# ── Optional: HuggingFace ──────────────────────────────────────────────────
# Model weights are public and need no token. Set one only to raise rate
# limits, or to access the gated evaluation dataset.
# HUGGINGFACE_TOKEN=
